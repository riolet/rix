# Prime counting benchmark
# Counts the number of primes up to a limit using trial division

isPrime -> bool(int n)
    if n < 2
        return false
    if n == 2
        return true
    if n % 2 == 0
        return false

    upperLimit := sqrt(n)
    i := 3
    while i <= upperLimit
        if n % i == 0
            return false
        i += 2

    return true

limit := 2000000
noPrimes := 0
n := 0

while n <= limit
    if isPrime(n)
        noPrimes += 1
    n += 1

print("pi(" + limit + ") = " + noPrimes)
