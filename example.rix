Rectangle :: 
  w = int
  h = int

  #constructor
  $(int w, int h)
    $.w = w
    $.h = h

  #One line function
  area->int() = w * h

  perimeter->int() = ( w + h ) *2


NamedRectangle :: Rectangle
  name = String
  $(int w, int h, String name)
    $.w = w
    $.h = h
    $.name = name
  nameArea->String() = "NamedRectangle "+ name + " has an area of "+$.area()

# := is the equivalanet of saying r = new Rectangle(5,10) in other Object Oriented Languages
# Types are inferred when a new variable is created
r := Rectangle (5, 10)
s := NamedRectangle (3, 4, "Great")

print (s.name)
print (r.area() + " " + r.perimeter())
print (s.name + " " + s.area())
print (s.nameArea())

y := 5
#Once a variable is created you use = for assignment with the correct type
y = y + 2

#Another one line function
fib -> int(int n) = (n <= 1).tf (n, fib (n-1) + fib (n-2))

#Read command line arguments
if args()>1
    .N = int (args (1))
    #For loops
    for i := 1 to N+1
        print (i + ": " + fib (i))
else
    print ("Usage "+args(0)+" N")

