{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(if|else|for|\\$\\(|\\w+\\s*::|\\w+\\s*->\\s*\\w+\\s*\\([^=]*\\)\\s*).*$",
    "decreaseIndentPattern": "^\\s*(else)\\s*$"
  }
}
